<Window x:Class="HizliErisim.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hızlı Erişim" Height="680" Width="1020" MinWidth="880" MinHeight="420"
        Background="{StaticResource Bg}" Foreground="{StaticResource TextPrimary}"
        FontFamily="Segoe UI" Icon="Assets/logo.png" WindowStartupLocation="CenterScreen"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop">
    <Grid Margin="24,20,24,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Image Source="Assets/logo.png" Width="46" Height="46"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Hızlı Erişim" FontSize="22" FontWeight="Bold"/>
                <TextBlock Text="Dosyalarınız, linkleriniz ve uygulamalarınız tek yerde"
                           FontSize="12" Foreground="{StaticResource TextSecondary}"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Şablonlar" Style="{StaticResource GhostButton}" Margin="0,0,16,0" Click="Templates_Click"/>
                <Button Content="＋ Dosya / Klasör" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="AddFile_Click"/>
                <Button Content="＋ Link" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="AddUrl_Click"/>
                <Button Content="＋ Uygulama" Style="{StaticResource PrimaryButton}" Click="AddApp_Click"/>
            </StackPanel>
        </Grid>

        <!-- Search + filter -->
        <Grid Grid.Row="1" Margin="0,18,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid Width="280">
                <TextBox x:Name="SearchBox" Padding="12,9" TextChanged="SearchBox_TextChanged"/>
                <TextBlock x:Name="SearchHint" Text="Ara…" IsHitTestVisible="False"
                           Foreground="{StaticResource TextSecondary}" Margin="14,0,0,0" VerticalAlignment="Center"/>
            </Grid>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                <RadioButton Content="Tümü" Tag="All" IsChecked="True" Style="{StaticResource Chip}" Checked="Chip_Checked"/>
                <RadioButton Content="Dosyalar" Tag="File" Style="{StaticResource Chip}" Checked="Chip_Checked"/>
                <RadioButton Content="Linkler" Tag="Url" Style="{StaticResource Chip}" Checked="Chip_Checked"/>
                <RadioButton Content="Uygulamalar" Tag="App" Style="{StaticResource Chip}" Checked="Chip_Checked"/>
            </StackPanel>
        </Grid>

        <!-- Cards -->
        <Grid Grid.Row="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="ItemsHost" Margin="-8,6,-8,12">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource CardButton}" Width="220" Height="158" Margin="8"
                                    Click="Card_Click" ToolTip="{Binding Target}">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Aç" Click="Open_Click"/>
                                        <MenuItem Header="Düzenle" Click="Edit_Click"/>
                                        <Separator/>
                                        <MenuItem Header="Sil" Click="Delete_Click"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <Grid Width="48" Height="48" HorizontalAlignment="Left">
                                            <Image Source="{Binding Icon}" Width="44" Height="44"
                                                   RenderOptions.BitmapScalingMode="HighQuality">
                                                <Image.Style>
                                                    <Style TargetType="Image">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasIcon}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Image.Style>
                                            </Image>
                                            <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="34"
                                                       Foreground="{StaticResource Accent}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasIcon}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Background="{StaticResource Surface}" CornerRadius="8" Padding="8,2">
                                            <TextBlock Text="{Binding TypeLabel}" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextSecondary}"/>
                                        </Border>
                                    </Grid>
                                    <TextBlock Grid.Row="1" Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" Margin="0,10,0,3"/>
                                    <TextBlock Grid.Row="2" Text="{Binding Description}" FontSize="12"
                                               Foreground="{StaticResource TextSecondary}"
                                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                               LineHeight="16" LineStackingStrategy="BlockLineHeight"
                                               MaxHeight="32" VerticalAlignment="Top" ClipToBounds="True"/>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center"
                        IsHitTestVisible="False" Visibility="Collapsed">
                <TextBlock Text="⚡" FontSize="48" HorizontalAlignment="Center"/>
                <TextBlock x:Name="EmptyTitle" FontSize="18" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,8,0,4"/>
                <TextBlock x:Name="EmptyText" FontSize="13" Foreground="{StaticResource TextSecondary}"
                           HorizontalAlignment="Center" TextAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
