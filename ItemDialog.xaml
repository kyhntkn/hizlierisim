<Window x:Class="HizliErisim.ItemDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="500" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Icon="Assets/logo.png"
        Background="{StaticResource Bg}" Foreground="{StaticResource TextPrimary}" FontFamily="Segoe UI">
    <StackPanel Margin="26,22,26,22">
        <TextBlock x:Name="Heading" FontSize="19" FontWeight="SemiBold"/>

        <TextBlock x:Name="TargetLabel" Style="{StaticResource FieldLabel}"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TargetBox" LostFocus="TargetBox_LostFocus"/>
            <StackPanel x:Name="BrowsePanel" Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                <Button x:Name="BrowseFileBtn" Content="Dosya…" Style="{StaticResource GhostButton}"
                        Padding="12,7" Click="BrowseFile_Click"/>
                <Button x:Name="BrowseFolderBtn" Content="Klasör…" Style="{StaticResource GhostButton}"
                        Padding="12,7" Margin="6,0,0,0" Click="BrowseFolder_Click"/>
            </StackPanel>
        </Grid>

        <TextBlock Text="Başlık" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="TitleBox"/>

        <TextBlock Text="Açıklama (isteğe bağlı)" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="DescBox" Height="74" AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Content="İptal" Style="{StaticResource GhostButton}" IsCancel="True" Margin="0,0,8,0" Width="90"/>
            <Button Content="Kaydet" Style="{StaticResource PrimaryButton}" IsDefault="True" Width="110" Click="Save_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
